<Window x:Class="GuardNest.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maryada Setup" Width="660" Height="590"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FFF8FAFC" Icon="pack://application:,,,/GuardNest.Setup;component/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="174" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}">
            <Grid Margin="34,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="82" Height="82" CornerRadius="15" Background="White"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/GuardNest.Setup;component/Assets/logo.png" Width="68" Height="68" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="Maryada" Foreground="White" FontSize="30" FontWeight="Bold" />
                    <TextBlock x:Name="HeroText" Text="Family protection for this PC"
                               Foreground="#FFE0E7FF" FontSize="15" Margin="0,6,0,0" />
                    <Border Background="#30FFFFFF" CornerRadius="5" Padding="9,4"
                            HorizontalAlignment="Left" Margin="0,14,0,0">
                        <TextBlock Foreground="White" FontSize="11">
                            <Run Text="Made with " /><Run Text="♥" Foreground="#FFFF4D5A" /><Run Text=" by ISKCON Brahmapur" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="34,24,34,14">
            <StackPanel x:Name="ReadyPanel">
                <TextBlock x:Name="HeadingText" Text="Protect this computer"
                           Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="DescriptionText"
                           Text="Maryada runs quietly in the background and applies the rules chosen in the parent app."
                           Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                           Margin="0,8,0,18" LineHeight="20" />

                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="7" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="✓  Starts automatically with Windows" Foreground="{StaticResource Ink}" FontSize="13" />
                        <TextBlock Text="✓  Enforces screen time, apps and safe browsing" Foreground="{StaticResource Ink}" FontSize="13" Margin="0,9,0,0" />
                        <TextBlock Text="✓  Protected by a SYSTEM service" Foreground="{StaticResource Ink}" FontSize="13" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="PairingCard" Background="White"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="7" Padding="16,12" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Pair with the parent app"
                                       Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Enter the one-time code before installation can finish."
                                       Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock x:Name="PairMessage" Foreground="#FFDC2626" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBox x:Name="CodeBox" Grid.Column="1" Height="42"
                                 FontSize="20" FontWeight="Bold" Padding="10,5"
                                 VerticalContentAlignment="Center" CharacterCasing="Upper"
                                 MaxLength="10" BorderBrush="{StaticResource Line}"
                                 BorderThickness="1" ToolTip="Pairing code" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressHeading" Text="Installing Maryada"
                           Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Preparing…" Foreground="{StaticResource Muted}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,20" />
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>

            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Border x:Name="ResultBadge" Width="58" Height="58" CornerRadius="29"
                        Background="#FFDCFCE7" HorizontalAlignment="Center">
                    <TextBlock x:Name="ResultMark" Text="✓" Foreground="#FF15803D" FontSize="30"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ResultHeading" Text="Maryada is installed"
                           Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="ResultMessage" Foreground="{StaticResource Muted}" FontSize="13"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                           HorizontalAlignment="Center" MaxWidth="500" Margin="0,9,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="28,14">
                <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Visibility="Collapsed" Click="RemoveButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Click="CloseButton_Click" Margin="0,0,10,0" />
                    <Button x:Name="PrimaryButton" Content="Install and connect" Style="{StaticResource PrimaryButton}"
                            Click="PrimaryButton_Click" MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
