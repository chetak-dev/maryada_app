<Window x:Class="GuardNest.Agent.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maryada" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="False"
        Background="{StaticResource BrandGradient}" Icon="pack://application:,,,/GuardNest.Agent;component/Assets/logo.png">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <Border Width="108" Height="108" CornerRadius="20" Background="White"
                    BorderBrush="#55FFFFFF" BorderThickness="4"
                    HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/GuardNest.Agent;component/Assets/logo.png" Width="88" Height="88"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="TitleText" Text="Paused" Foreground="White" FontSize="40"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,28,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />

            <TextBlock x:Name="SubtitleText" Text="" Foreground="#FFE0E7FF" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />

            <Border x:Name="DetailBadge" Background="#33FFFFFF" CornerRadius="10"
                    Padding="16,8" HorizontalAlignment="Center" Margin="0,20,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="DetailText" Foreground="White" FontSize="15" FontWeight="SemiBold" />
            </Border>

            <StackPanel x:Name="ActionButtons" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,30,0,0"
                        Visibility="Collapsed">
                <Button x:Name="BackButton" Content="Go back" Click="BackButton_Click"
                        Style="{StaticResource OverlayButton}" Margin="0,0,12,0" />
                <Button x:Name="HomeButton" Content="Go home" Click="HomeButton_Click"
                        Style="{StaticResource OverlayGhostButton}" />
            </StackPanel>

            <TextBlock Foreground="#FFC7D2FE" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,44,0,0">
                <Run Text="Made with " /><Run Text="♥" Foreground="#FFFF4D5A" /><Run Text=" by ISKCON Brahmapur" />
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
