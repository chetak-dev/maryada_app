<Window x:Class="GuardNest.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maryada" Height="520" Width="420"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="White" Icon="pack://application:,,,/GuardNest.Agent;component/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="50" Height="50" CornerRadius="9" Background="White"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/GuardNest.Agent;component/Assets/logo.png" Width="42" Height="42" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Maryada" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Family protection for this PC"
                               Foreground="#FFE0E7FF" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20">
            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="STATUS" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Starting…" Foreground="{StaticResource TextPrimary}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText" Text="" Foreground="{StaticResource TextSecondary}"
                               FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>

        <StackPanel Grid.Row="2" Margin="24,0,24,18">
            <TextBlock x:Name="VersionText" Text="v1.0.0(1)" Foreground="{StaticResource TextSecondary}"
                       FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,0">
                <Run Text="Made with " /><Run Text="♥" Foreground="#FFFF4D5A" /><Run Text=" by ISKCON Brahmapur" />
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
