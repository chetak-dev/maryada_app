rules_version = '2';

// GuardNest — Firestore security rules.
// Model: guardians (in a family's parentUids) fully manage their family. A
// paired child device (anonymous auth) is bound to one child doc via
// `deviceUid` and may only touch its own subtree. Review before production.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ----- Account roles (Site admin -> Org admin) -----
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userRole() {
      return hasUserDoc() ? userData().role : '';
    }
    // The site admin (formerly 'admin'); the legacy id is kept so existing
    // accounts keep working.
    function isAdmin() {
      return userRole() == 'siteAdmin' || userRole() == 'admin';
    }
    // Any org admin (parent). All org admins share one view of all children.
    function isOrgAdmin() {
      return userRole() == 'orgAdmin' || userRole() == 'host';
    }
    // An org admin's granted access ('view' | 'edit'). Legacy accounts have no
    // access field and are treated as editors so nothing they could do breaks.
    function myAccess() {
      return hasUserDoc() ? userData().get('access', 'edit') : 'edit';
    }
    // May add children / change rules: site admins always, org admins only with
    // edit access. Requires a real account record, so removing (deleting) an
    // org admin immediately revokes their edit access.
    function canEdit() {
      return isAdmin() || (hasUserDoc() && myAccess() == 'edit');
    }
    // The family the site admin's grant assigned to this account, if any. It is
    // how a second parent joins an existing household.
    function myFamilyId() {
      return hasUserDoc() ? userData().get('familyId', '') : '';
    }
    function inviteGrant(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }
    // The account record `d` faithfully reflects an unused grant issued to the
    // signed-in address. Grants are stored under the granted email (older ones
    // under a random code), and `inviteCode` names the one being redeemed.
    function grantMatches(d) {
      return d.role in ['orgAdmin', 'host']
        && d.inviteCode is string
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/invites/$(d.inviteCode))
        && inviteGrant(d.inviteCode).used == false
        && inviteGrant(d.inviteCode).email == request.auth.token.email.lower()
        && d.access == inviteGrant(d.inviteCode).get('access', 'edit')
        && d.get('familyId', '') == inviteGrant(d.inviteCode).get('familyId', '')
        && d.maxChildren == inviteGrant(d.inviteCode).maxChildren;
    }

    // Signed-in account records. The site admin is bootstrapped by a fixed
    // email; an org admin may only be created with a valid, unused access grant
    // for their email; everyone else is a privilege-less 'user'. Role, access,
    // child limit and suspension can only be changed by the site admin.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && (
          (request.resource.data.role in ['siteAdmin', 'admin']
            && request.auth.token.email == 'chetakkumarpradhan@gmail.com')
          || request.resource.data.role == 'user'
          || grantMatches(request.resource.data)
        );
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.access == resource.data.access
            && request.resource.data.maxChildren == resource.data.maxChildren
            && request.resource.data.suspended == resource.data.suspended)
        // Redeeming a grant on an account that already exists, which is how a
        // re-grant (say edit -> view only) takes effect. Role, access and limit
        // come from the grant, and a suspension can't be lifted this way.
        || (isSignedIn() && request.auth.uid == uid
            && grantMatches(request.resource.data)
            && request.resource.data.get('suspended', false)
               == resource.data.get('suspended', false));
      allow delete: if isAdmin();
    }

    // Access grants created by the site admin (`invites/{email}`). Any signed-in
    // user may read (to find/redeem their own grant); only the site admin
    // creates/deletes; redemption is a one-way used:false -> true update.
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.used == false
            && request.resource.data.used == true
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']));
    }

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isParentOf(familyId) {
      return isSignedIn() && request.auth.uid in familyData(familyId).parentUids;
    }

    function childDeviceUid(familyId, childId) {
      return get(/databases/$(database)/documents/families/$(familyId)/children/$(childId)).data.deviceUid;
    }

    // ----- Paired child devices -----
    // A child device signs in anonymously, so "signed in" says nothing about
    // who it is. `devices/{uid}` is the device's proof of which family/child it
    // belongs to: it can only be written when that child doc already names this
    // uid as its deviceUid (see the pairing handshake below), so a device can
    // never point itself at someone else's family.
    function deviceDoc() {
      return get(/databases/$(database)/documents/devices/$(request.auth.uid)).data;
    }
    function hasDeviceDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/devices/$(request.auth.uid));
    }
    function isDeviceOfFamily(familyId) {
      return hasDeviceDoc() && deviceDoc().familyId == familyId;
    }
    function isDeviceOfChild(familyId, childId) {
      return hasDeviceDoc()
        && deviceDoc().familyId == familyId
        && deviceDoc().childId == childId;
    }

    // The device's own registration. Writable only by that device, and only
    // once the child doc it names has already been bound to this uid.
    match /devices/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid
            || isAdmin()
            || isParentOf(resource.data.familyId));
      // The device removes its own registration when unpaired; a guardian can
      // also clear it, so a device that never comes back online can't keep
      // reading the family's rules forever.
      allow delete: if isSignedIn()
        && (request.auth.uid == uid
            || isAdmin()
            || (isParentOf(resource.data.familyId) && canEdit()));
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.familyId is string
        && request.resource.data.childId is string
        && childDeviceUid(
             request.resource.data.familyId,
             request.resource.data.childId
           ) == request.auth.uid;
    }

    // A device claiming a child slot for the first time must present the
    // one-time pairing code that the parent generated for exactly that child.
    // Without this any anonymous client that guessed a family/child id could
    // write itself in as the device and take the slot over.
    function isPairingClaim(familyId, childId) {
      return request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.pairingCode is string
        && exists(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode))
        && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.used == false
        && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.familyId == familyId
        && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.childId == childId;
    }

    // A device that is already bound to this child keeps writing (heartbeat,
    // reports) as itself, and can never hand the slot to another uid.
    function isBoundDevice() {
      return isSignedIn()
        && resource != null
        && resource.data.deviceUid == request.auth.uid
        && request.resource.data.deviceUid == request.auth.uid;
    }

    // Every registered device of this child, not just the one holding the
    // pairing slot: they all report their own state into the profile's
    // `devices` map. Registration already proves this uid was paired to this
    // child, and it must not be able to take the slot from another device.
    function isChildDevice(familyId, childId) {
      return isDeviceOfChild(familyId, childId)
        && request.resource.data.get('deviceUid', '')
             == resource.data.get('deviceUid', '');
    }

    // Collection-group read of every child, for the site admin only. Parents
    // are isolated per family and must never be able to query across families,
    // so no org-admin access here.
    match /{path=**}/children/{childId} {
      allow read: if isAdmin();
    }

    match /families/{familyId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.parentUids);
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && request.auth.uid in request.resource.data.parentUids
            && canEdit());
      allow update: if isSignedIn()
        && (
          (request.auth.uid in resource.data.parentUids && canEdit())
          // A second guardian joining the household their grant named. They may
          // only add themselves, and only to that one family.
          || (isOrgAdmin()
              && myFamilyId() == familyId
              && !(request.auth.uid in resource.data.parentUids)
              && request.resource.data.parentUids
                  == resource.data.parentUids.concat([request.auth.uid])
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.name == resource.data.name)
          // Leaving a household their grant no longer names: remove only
          // themselves, change nothing else. This is how a moved parent stops
          // seeing their previous family.
          || (request.auth.uid in resource.data.parentUids
              && myFamilyId() != familyId
              && request.resource.data.parentUids
                  == resource.data.parentUids.removeAll([request.auth.uid])
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.name == resource.data.name)
        );
      // The owner, or the site admin (the app only offers it for families with
      // no children/devices; rules can't see subcollections, so the emptiness
      // check lives in the console).
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerUid == request.auth.uid
            && canEdit());

      // Family-wide rules (screen time, app rules, web filter): editor guardians
      // write; a paired device of THIS family may read to enforce locally.
      // (Previously any signed-in user could read these — and child devices use
      // anonymous auth, so that meant anyone at all.)
      match /rules/{doc} {
        allow read: if isAdmin() || isParentOf(familyId)
          || isDeviceOfFamily(familyId);
        allow write: if isAdmin() || (isParentOf(familyId) && canEdit());
      }
      match /appRules/{doc} {
        allow read: if isAdmin() || isParentOf(familyId)
          || isDeviceOfFamily(familyId);
        allow write: if isAdmin() || (isParentOf(familyId) && canEdit());
      }

      match /children/{childId} {
        allow read: if isAdmin()
          || isParentOf(familyId)
          || (isSignedIn() && resource.data.deviceUid == request.auth.uid)
          || isDeviceOfChild(familyId, childId);
        // Only THIS family's editors. `canEdit()` alone let any editing org
        // admin write any family's children.
        allow write: if (isParentOf(familyId) && canEdit())
          || isAdmin()
          || isBoundDevice()
          || isChildDevice(familyId, childId)
          || isPairingClaim(familyId, childId);

        // Per-child subtree (usage, location, geofences, installed apps, ...).
        match /{document=**} {
          allow read: if isAdmin()
            || isParentOf(familyId)
            || isDeviceOfChild(familyId, childId)
            || (isSignedIn() && childDeviceUid(familyId, childId) == request.auth.uid);
          allow write: if (isParentOf(familyId) && canEdit())
            || isAdmin()
            || isDeviceOfChild(familyId, childId)
            || (isSignedIn() && childDeviceUid(familyId, childId) == request.auth.uid);
        }
      }

      match /alerts/{alertId} {
        allow read: if isAdmin() || isParentOf(familyId);
        allow update, delete: if isAdmin() || (isParentOf(familyId) && canEdit());
        allow create: if (isParentOf(familyId) && canEdit())
          || isDeviceOfChild(familyId, request.resource.data.childId)
          || (isSignedIn()
              && childDeviceUid(familyId, request.resource.data.childId)
                  == request.auth.uid);
      }
    }

    // App update manifest (OTA). Any signed-in device may read the latest
    // version + APK URL; only the site admin may publish.
    match /appConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // One-time pairing codes. A signed-in user may read a code by its exact id;
    // only a guardian of the referenced family may create/delete. Redemption is
    // limited to the handshake, and only the device that actually claimed the
    // child slot may mark the code used — otherwise any signed-in client could
    // burn a parent's codes before the child device got to use them.
    match /pairingCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isParentOf(request.resource.data.familyId) && canEdit();
      allow delete: if isParentOf(resource.data.familyId) && canEdit();
      allow update: if (isParentOf(resource.data.familyId) && canEdit())
        || (isSignedIn()
            && resource.data.used == false
            && isDeviceOfChild(resource.data.familyId, resource.data.childId)
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['used', 'usedAt']));
    }
  }
}
