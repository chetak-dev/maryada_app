rules_version = '2';

// GuardNest — Firestore security rules.
// Model: guardians (in a family's parentUids) fully manage their family. A
// paired child device (anonymous auth) is bound to one child doc via
// `deviceUid` and may only touch its own subtree. Review before production.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isParentOf(familyId) {
      return isSignedIn() && request.auth.uid in familyData(familyId).parentUids;
    }

    function childDeviceUid(familyId, childId) {
      return get(/databases/$(database)/documents/families/$(familyId)/children/$(childId)).data.deviceUid;
    }

    match /families/{familyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.parentUids;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.parentUids;
      allow update: if isSignedIn() && request.auth.uid in resource.data.parentUids;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Family-wide rules (screen time, app rules, web filter): guardians write,
      // any paired child device may read to enforce locally.
      match /rules/{doc} {
        allow read: if isSignedIn();
        allow write: if isParentOf(familyId);
      }
      match /appRules/{doc} {
        allow read: if isSignedIn();
        allow write: if isParentOf(familyId);
      }

      match /children/{childId} {
        allow read: if isParentOf(familyId)
          || (isSignedIn() && resource.data.deviceUid == request.auth.uid);
        allow write: if isParentOf(familyId)
          || (isSignedIn() && request.resource.data.deviceUid == request.auth.uid);

        // Per-child subtree (usage, location, geofences, installed apps, ...).
        match /{document=**} {
          allow read: if isParentOf(familyId)
            || (isSignedIn() && childDeviceUid(familyId, childId) == request.auth.uid);
          allow write: if isParentOf(familyId)
            || (isSignedIn() && childDeviceUid(familyId, childId) == request.auth.uid);
        }
      }

      match /alerts/{alertId} {
        allow read, update, delete: if isParentOf(familyId);
        allow create: if isParentOf(familyId)
          || (isSignedIn()
              && childDeviceUid(familyId, request.resource.data.childId)
                  == request.auth.uid);
      }
    }

    // App update manifest (OTA). Any signed-in device may read the latest
    // version + APK URL; only a real (non-anonymous) parent account may publish.
    match /appConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // One-time pairing codes. A signed-in user may read a code by its exact id;
    // only a guardian of the referenced family may create/delete; updates are
    // limited to the redemption handshake (marking used).
    match /pairingCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isParentOf(request.resource.data.familyId);
      allow delete: if isParentOf(resource.data.familyId);
      allow update: if isParentOf(resource.data.familyId)
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['used', 'usedAt']));
    }
  }
}
