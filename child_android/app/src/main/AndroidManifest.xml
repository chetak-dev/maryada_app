<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Full-screen lock overlay for pause / bedtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Parental control needs to see every installed app to list and manage
         them (Android 11+ hides the full package list without this). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Location, for showing the child's device position to the guardian. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Usage access (screen-time reporting). Granted by the user in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Call history, so the guardian can review the child's calls. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- SMS history, so the guardian can review the child's text messages. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Install the OTA self-update APK (silent on Device Owner). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="Maryada"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- Ask Google Play Services to download the OCR (text-recognition)
             model automatically after install, so the unbundled recognizer is
             ready before it's first used. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen "website blocked" page shown by the accessibility
             service when the browser reaches an unsafe site. -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".block"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Device Administrator receiver. Combined with Device Owner
             enrollment, this is what makes the app un-removable. -->
        <receiver
            android:name=".GuardNestAdminReceiver"
            android:description="@string/admin_description"
            android:label="Maryada"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Always-on enforcement (bedtime/pause lock), kept alive as a
             foreground service and restarted on boot. -->
        <service
            android:name=".EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control screen-time and device enforcement" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <!-- Restart the service after the app is updated (install -r). -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Result of an OTA self-update install session (AppUpdater). -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.guardnest.kid.UPDATE_INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Re-posts the Temporary Access notice the moment it is swiped away. -->
        <receiver
            android:name=".TempAccessNotice$DismissReceiver"
            android:exported="false" />

        <!-- Opt-in web filter. A local DNS-only VPN that blocks configured
             sites; Android shows a consent dialog before it can start. -->
        <service
            android:name=".WebFilterVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- App-blocking enforcement without Device Owner: bounces the child out
             of blocked apps. Granted by the child in Accessibility settings. -->
        <service
            android:name=".GuardNestAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Optional YouTube history enhancement. Not used to read notifications:
             a NotificationListenerService is the only component allowed to reach
             active media sessions, which is how we capture the YouTube video
             title/channel/watch-time even in full-screen or in the background.
             The child grants "Notification access" in Settings. -->
        <service
            android:name=".GuardNestNotificationListener"
            android:exported="false"
            android:label="Maryada"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
